# EK Trip Dashboard — environment variables
# Copy this file to .env and fill in your keys.
# The app works without any keys — it shows scheduled data and static advisories.
# Adding keys enables live flight status and weather.

# --- Flight status ---
# Free tier: 100 calls/month (plenty for personal use with 5-min caching)
# Sign up: https://aviationstack.com/signup/free
AVIATIONSTACK_API_KEY=

# --- Weather ---
# Free tier: 1,000 calls/day
# Sign up: https://home.openweathermap.org/users/sign_up
OPENWEATHERMAP_API_KEY=
