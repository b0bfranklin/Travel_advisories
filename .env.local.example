# =============================================================================
# Travel Disruption & Advisory Hub — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is in .gitignore.
# This file (.env.local.example) IS committed and documents all required vars.
# =============================================================================

# -----------------------------------------------------------------------------
# Site Configuration
# -----------------------------------------------------------------------------
# The public URL of your site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://tripwatch.io

# -----------------------------------------------------------------------------
# Supabase — Database & Auth
# https://supabase.com → Project Settings → API
# -----------------------------------------------------------------------------
# The public URL of your Supabase project
NEXT_PUBLIC_SUPABASE_URL=

# The public anon key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key — NEVER expose to the browser (server-side only)
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Flight Data APIs
# -----------------------------------------------------------------------------
# AviationStack — https://aviationstack.com (Phase 1 growth)
# Free tier: 100 req/month. Paid: ~$15/mo for 10k.
AVIATIONSTACK_API_KEY=

# FlightAware AeroAPI — https://flightaware.com/commercial/aeroapi (Phase 1 growth)
FLIGHTAWARE_API_KEY=

# OpenSky Network — https://opensky-network.org (free, no key required for MVP)
# Optional: create an account for higher rate limits
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# -----------------------------------------------------------------------------
# Road / Map APIs (Phase 3)
# -----------------------------------------------------------------------------
# HERE Maps — https://developer.here.com (free tier: 250k transactions/month)
HERE_MAPS_API_KEY=

# TomTom — https://developer.tomtom.com (free tier: 2500 req/day)
TOMTOM_API_KEY=

# -----------------------------------------------------------------------------
# Weather (All phases)
# BOM (Bureau of Meteorology) — open data, no key required
# OpenWeatherMap — https://openweathermap.org/api (free: 1,000 calls/day)
# -----------------------------------------------------------------------------
OPENWEATHERMAP_API_KEY=

# -----------------------------------------------------------------------------
# Maritime (Phase 4)
# -----------------------------------------------------------------------------
MARINETRAFFIC_API_KEY=

# -----------------------------------------------------------------------------
# Caching — Upstash Redis
# https://upstash.com → Create Redis database → REST API
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Email Alerts — Resend
# https://resend.com → API Keys
# Free tier: 3,000 emails/month
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# The from address for alert emails (must be a verified domain in Resend)
RESEND_FROM_EMAIL=alerts@tripwatch.io

# -----------------------------------------------------------------------------
# SMS Alerts — Twilio (optional, gate behind opt-in)
# https://twilio.com → Console → Account Info
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# Translation — DeepL (Phase 5)
# https://www.deepl.com/pro-api
# Free tier: 500k characters/month
# -----------------------------------------------------------------------------
DEEPL_API_KEY=

# -----------------------------------------------------------------------------
# Analytics & Monitoring
# -----------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console API (for admin dashboard SEO stats)
GOOGLE_SEARCH_CONSOLE_API_KEY=

# Sentry DSN — https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Affiliate & Redirect System
# The public base URL for /go/ redirect links
# -----------------------------------------------------------------------------
AFFILIATE_BASE_URL=https://tripwatch.io/go/
